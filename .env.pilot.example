# Copy to a secret-managed deployment environment. Never commit the populated file.
ASPNETCORE_ENVIRONMENT=Pilot
POSTGRES_DB=CreatorPayPilotDb
POSTGRES_USER=creatorpay_pilot
POSTGRES_PASSWORD=replace-in-secret-provider
Authentication__Jwt__Issuer=CreatorPay.Pilot
Authentication__Jwt__Audience=CreatorPay.Pilot.Web
Authentication__Jwt__SigningKey=replace-in-secret-provider-minimum-32-characters
CustomerVerification__HmacSecret=replace-in-secret-provider-minimum-32-characters
CustomerVerification__EncryptionKey=replace-in-secret-provider-minimum-32-characters
WEB_ORIGIN=https://pilot.example.invalid
VITE_API_URL=https://api.pilot.example.invalid
Support__Email=pilot-support@example.invalid
Storage__Provider=MetadataOnly
Storage__ConnectionString=
FeatureFlags__ExternalSms=false
FeatureFlags__ExternalEmail=false
FeatureFlags__ExternalPaymentProvider=false
FeatureFlags__AutomaticPayouts=false
FeatureFlags__PublicRegistration=false
FeatureFlags__PublicDiscovery=false
FeatureFlags__SupportNotifications=false
FeatureFlags__ProductionMonitoring=false
FeatureFlags__MaintenanceMode=false
