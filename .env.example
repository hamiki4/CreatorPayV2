POSTGRES_DB=CreatorPayV2Db
POSTGRES_USER=creatorpay
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
ConnectionStrings__CreatorPayDatabase=Host=localhost;Port=5432;Database=CreatorPayV2Db;Username=creatorpay;Password=replace-with-a-local-development-password
Authentication__Jwt__Issuer=CreatorPay
Authentication__Jwt__Audience=CreatorPay.Web
Authentication__Jwt__SigningKey=replace-with-at-least-32-random-characters
Authentication__Jwt__AccessTokenMinutes=15
Authentication__Jwt__RefreshTokenDays=30
CustomerVerification__HmacSecret=replace-with-at-least-32-random-secret-characters
CustomerVerification__EncryptionKey=replace-with-at-least-32-random-key-characters
CustomerVerification__RepeatUseApprovalExpirationMinutes=15
CustomerVerification__RequireCustomerOtpForRepeatUse=true
CustomerVerification__RequireSupervisorApprovalForRepeatUse=true
CustomerVerification__MaximumRepeatUseApprovalsPerDay=3
CustomerVerification__CustomerVerificationCodeLifetimeMinutes=5
CustomerVerification__CustomerVerificationMaxAttempts=5
CustomerVerification__ReturnDevelopmentCode=false
ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins__0=http://localhost:5173
# Immediate reverse-proxy IP only; add indexed entries for multiple proxy hops.
ReverseProxy__KnownProxies__0=
FeatureFlags__DevelopmentOtpReveal=false
FeatureFlags__DevelopmentInvitationTokenReveal=false
FeatureFlags__RealNotificationProviders=false
FeatureFlags__AutomaticPayouts=false
FeatureFlags__OfflineSync=false
FeatureFlags__PublicQrResolution=false
FeatureFlags__PlatformAdminOperations=false
BackgroundWorkers__Enabled=true
BackgroundWorkers__PollIntervalSeconds=10
Storage__Provider=MetadataOnly
Storage__ConnectionString=
Observability__EnableOtlpExporter=false
Observability__OtlpEndpoint=
ErrorMonitoring__Enabled=false
ErrorMonitoring__Endpoint=
ErrorMonitoring__Environment=production
Notifications__EmailProviderKey=
Notifications__SmsProviderKey=
Notifications__PushProviderCredentials=
Payments__ProviderCredentials=
HealthChecks__OperationsKey=
