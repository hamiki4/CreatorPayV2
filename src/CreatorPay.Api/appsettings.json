{
  "ConnectionStrings": {
    "CreatorPayDatabase": ""
  },
  "Authentication": {
    "Jwt": { "Issuer": "CreatorPay", "Audience": "CreatorPay.Web", "SigningKey": "", "AccessTokenMinutes": 15, "RefreshTokenDays": 30 },
    "Password": { "MinimumLength": 10, "MaximumLength": 128, "RequireUppercase": true, "RequireLowercase": true, "RequireDigit": true, "RequireNonAlphanumeric": true },
    "Lockout": { "MaxFailedAttempts": 5, "LockoutMinutes": 15 },
    "PasswordReset": { "TokenLifetimeMinutes": 30 }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
